<% if(success && success.length) { %>
<div class="alert alert-success alert-dismissible fade show col-6 offset-3">
    <%= success %>  
    <button type="button" class="btn-class" data-bs-dismiss="alert" aria-label="Close"></button>  
</div>
<% } %>

<% if(error && error.length) { %>
    <div class="alert alert-error alert-dismissible fade show col-6 offset-3">
        <%= error %>  
        <button type="button" class="btn-class" data-bs-dismiss="alert" aria-label="Close"></button>  
    </div>
    <% } %>